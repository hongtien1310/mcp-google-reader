{
  "name": "mcp-google-reader",
  "version": "1.0.0",
  "description": "MCP server to read Google Docs and Google Sheets content for AI assistants",
  "main": "dist/index.js",
  "bin": {
    "mcp-google-reader": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
